{
	"$schema": "https://swc.rs/schema.json",
	"jsc": {
		"baseUrl": "./",
		"parser": {
			"syntax": "typescript",
			"decorators": true,
			"dynamicImport": true
		},
		"transform": {
			"legacyDecorator": true,
			"decoratorMetadata": true
		},
		"target": "es2023"
	},
	// Disable minification to prevent single-line output
	"minify": false,
	// Enable source maps for proper debugging
	"sourceMaps": true,
	"module": {
		"type": "commonjs"
	}
}
