<!-- 
  Email Change OTP Template - Arabic Version (Modern UI)
  Expected Variables:
  - appName: string
  - otp: string | number
  - name?: string (optional)
-->
<!DOCTYPE html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>تأكيد بريدك الإلكتروني الجديد</title>
	</head>
	<body
		style="
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
			background-color: #f0f4f8;
			margin: 0;
			padding: 0;
			direction: rtl;
			text-align: right;
			-webkit-font-smoothing: antialiased;
		"
	>
		<table
			role="presentation"
			width="100%"
			cellspacing="0"
			cellpadding="0"
			border="0"
			style="background-color: #f0f4f8; padding: 40px 0"
		>
			<tr>
				<td align="center">
					<!-- Main Card Container -->
					<table
						role="presentation"
						width="100%"
						style="
							max-width: 580px;
							background-color: #ffffff;
							border-radius: 16px;
							box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
							overflow: hidden;
							border-collapse: collapse;
						"
					>
						<!-- Modern Hero Header with Gradient & Email Icon -->
						<tr>
							<td
								style="
									background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
									padding: 45px 30px;
									text-align: center;
								"
							>
								<!-- Icon Wrapper -->
								<div
									style="
										display: inline-block;
										background: rgba(255, 255, 255, 0.1);
										border: 1px solid rgba(255, 255, 255, 0.2);
										width: 64px;
										height: 64px;
										line-height: 64px;
										border-radius: 50%;
										margin-bottom: 16px;
										text-align: center;
									"
								>
									<span style="font-size: 28px; line-height: 64px">✉️</span>
								</div>

								<h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: 0.5px">
									<%= appName %>
								</h1>
							</td>
						</tr>

						<!-- Body Content Area -->
						<tr>
							<td style="padding: 40px 35px">
								<h2 style="color: #0f172a; margin-top: 0; margin-bottom: 20px; font-size: 22px; font-weight: 700">
									تأكيد تغيير البريد الإلكتروني
								</h2>

								<p style="color: #334155; font-size: 15px; line-height: 1.7; margin-bottom: 16px">
									مرحباً
									<strong style="color: #0f172a; text-transform: capitalize">
										<%= typeof name !== 'undefined' && name ? name : 'عميلنا العزيز' %>
									</strong>
									،
								</p>

								<p style="color: #475569; font-size: 15px; line-height: 1.7; margin-bottom: 30px">
									لقد تلقينا طلباً لتغيير البريد الإلكتروني المرتبط بحسابك على منصة
									<strong><%= appName %></strong>
									. يرجى استخدام رمز التحقق التالية لتأكيد ملكية البريد الجديد:
								</p>

								<!-- Modern OTP Display Box -->
								<div style="text-align: center; margin: 35px 0">
									<div
										style="
											display: inline-block;
											background-color: #f0f7ff;
											color: #1e40af;
											font-size: 34px;
											font-weight: 800;
											letter-spacing: 8px;
											padding: 18px 42px;
											border-radius: 12px;
											border: 2px dashed #3b82f6;
											box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
											direction: ltr;
										"
									>
										<%= otp %>
									</div>
								</div>

								<p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 28px">
									هذا الرمز صالح لفترة زمنية محدودة فقط لأسباب أمنية. إذا لم تقم بطلب هذا التغيير، يمكنك تجاهل هذه
									الرسالة بأمان وسيظل بريدك الإلكتروني الحالي كما هو بدون تغيير.
								</p>

								<hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 30px 0" />

								<!-- Security Notice Card -->
								<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td
											style="
												background-color: #fef2f2;
												border-right: 4px solid #ef4444;
												padding: 14px 18px;
												border-radius: 6px;
											"
										>
											<p style="color: #991b1b; font-size: 13px; margin: 0; font-weight: 600; line-height: 1.5">
												⚠️ تنبيه أمني: لا تشارك هذا الرمز مطلقاً مع أي شخص تحت أي ظرف لضمان حماية خصوصية حسابك.
											</p>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<!-- Modern Footer -->
						<tr>
							<td
								style="
									background-color: #f8fafc;
									padding: 28px 35px;
									text-align: center;
									border-top: 1px solid #f1f5f9;
								"
							>
								<p style="color: #94a3b8; font-size: 12px; margin: 0 0 8px 0; line-height: 1.5">
									هذا البريد تم إرساله تلقائياً، يرجى عدم الرد على هذه الرسالة مباشرة.
								</p>
								<p style="color: #cbd5e1; font-size: 12px; margin: 0; font-weight: 500; direction: ltr">
									&copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
