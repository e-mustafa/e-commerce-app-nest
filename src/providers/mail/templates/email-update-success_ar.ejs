<!-- 
  Email Update Success Confirmation Template - Arabic Version
  Expected Variables:
  - appName: string
  - name?: string (optional)
-->
<!DOCTYPE html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>تم تحديث البريد الإلكتروني بنجاح</title>
	</head>
	<body
		style="
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
			background-color: #f0f4f8;
			margin: 0;
			padding: 0;
			direction: rtl;
			text-align: right;
			-webkit-font-smoothing: antialiased;
		"
	>
		<table
			role="presentation"
			width="100%"
			cellspacing="0"
			cellpadding="0"
			border="0"
			style="background-color: #f0f4f8; padding: 40px 0"
		>
			<tr>
				<td align="center">
					<!-- Container Card -->
					<table
						role="presentation"
						width="100%"
						style="
							max-width: 580px;
							background-color: #ffffff;
							border-radius: 16px;
							box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
							overflow: hidden;
							border-collapse: collapse;
						"
					>
						<!-- Modern Header with Success Icon -->
						<tr>
							<td
								style="
									background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
									padding: 45px 30px;
									text-align: center;
								"
							>
								<!-- Success Shield Icon -->
								<div
									style="
										display: inline-block;
										background: rgba(34, 197, 94, 0.15);
										border: 1px solid rgba(34, 197, 94, 0.3);
										width: 64px;
										height: 64px;
										line-height: 64px;
										border-radius: 50%;
										margin-bottom: 16px;
										text-align: center;
									"
								>
									<span style="font-size: 28px; line-height: 64px">✅</span>
								</div>

								<h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: 0.5px">
									<%= appName %>
								</h1>
							</td>
						</tr>

						<!-- Content Area -->
						<tr>
							<td style="padding: 40px 35px">
								<h2 style="color: #16a34a; margin-top: 0; margin-bottom: 20px; font-size: 22px; font-weight: 700">
									تم التحديث بنجاح!
								</h2>

								<p style="color: #334155; font-size: 15px; line-height: 1.7; margin-bottom: 16px">
									مرحباً
									<strong style="color: #0f172a; text-transform: capitalize">
										<%= typeof name !== 'undefined' && name ? name : 'عميلنا العزيز' %>
									</strong>
									،
								</p>

								<p style="color: #475569; font-size: 15px; line-height: 1.7; margin-bottom: 20px">
									نؤكد لك أنه تم تغيير البريد الإلكتروني المرتبط بحسابك على منصة
									<strong><%= appName %></strong>
									واستبداله بهذا البريد الحالي بنجاح.
								</p>

								<p style="color: #475569; font-size: 15px; line-height: 1.7; margin-bottom: 30px">
									بدءاً من الآن، يرجى استخدام هذا البريد الإلكتروني لتسجيل الدخول إلى حسابك، واستقبال جميع الرسائل
									القادمة، الإشعارات، والتنبيهات الأمنية.
								</p>

								<hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 30px 0" />

								<!-- Success Banner -->
								<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td
											style="
												background-color: #f0fdf4;
												border-right: 4px solid #22c55e;
												padding: 16px;
												border-radius: 8px;
											"
										>
											<p style="color: #15803d; font-size: 13px; margin: 0; font-weight: 600; line-height: 1.6">
												🛡️ فحص أمني: حسابك الآن مؤمن بالكامل بالبريد الجديد، وتم إلغاء ارتباط البريد القديم بشكل
												آمن.
											</p>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<!-- Modern Footer -->
						<tr>
							<td
								style="
									background-color: #f8fafc;
									padding: 28px 35px;
									text-align: center;
									border-top: 1px solid #f1f5f9;
								"
							>
								<p style="color: #94a3b8; font-size: 12px; margin: 0 0 8px 0; line-height: 1.5">
									هذا البريد تم إرساله تلقائياً لتأكيد الأمان، يرجى عدم الرد عليه مباشرة.
								</p>
								<p style="color: #cbd5e1; font-size: 12px; margin: 0; font-weight: 500; direction: ltr">
									&copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
