<!-- 
  Account Recovered & Email Reverted Template - Arabic Version
  Expected Variables:
  - appName: string
  - name?: string (optional)
-->
<!DOCTYPE html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>تم استعادة الحساب وتأمينه بنجاح</title>
	</head>
	<body
		style="
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
			background-color: #f0f4f8;
			margin: 0;
			padding: 0;
			direction: rtl;
			text-align: right;
			-webkit-font-smoothing: antialiased;
		"
	>
		<table
			role="presentation"
			width="100%"
			cellspacing="0"
			cellpadding="0"
			border="0"
			style="background-color: #f0f4f8; padding: 40px 0"
		>
			<tr>
				<td align="center">
					<!-- Container Card -->
					<table
						role="presentation"
						width="100%"
						style="
							max-width: 580px;
							background-color: #ffffff;
							border-radius: 16px;
							box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
							overflow: hidden;
							border-collapse: collapse;
						"
					>
						<!-- Modern Header with Security Icon -->
						<tr>
							<td
								style="
									background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
									padding: 45px 30px;
									text-align: center;
								"
							>
								<!-- Security Shield Icon -->
								<div
									style="
										display: inline-block;
										background: rgba(34, 197, 94, 0.15);
										border: 1px solid rgba(34, 197, 94, 0.3);
										width: 64px;
										height: 64px;
										line-height: 64px;
										border-radius: 50%;
										margin-bottom: 16px;
										text-align: center;
									"
								>
									<span style="font-size: 28px; line-height: 64px">🛡️</span>
								</div>

								<h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: 0.5px">
									<%= appName %>
								</h1>
							</td>
						</tr>

						<!-- Content Area -->
						<tr>
							<td style="padding: 40px 35px">
								<h2 style="color: #16a34a; margin-top: 0; margin-bottom: 20px; font-size: 22px; font-weight: 700">
									تم إلغاء التغيير وتأمين الحساب بنجاح
								</h2>

								<p style="color: #334155; font-size: 15px; line-height: 1.7; margin-bottom: 16px">
									مرحباً
									<strong style="color: #0f172a; text-transform: capitalize">
										<%= typeof name !== 'undefined' && name ? name : 'عميلنا العزيز' %>
									</strong>
									،
								</p>

								<p style="color: #475569; font-size: 15px; line-height: 1.7; margin-bottom: 16px">
									تم تنفيذ طلبك لإلغاء عملية نقل البريد الإلكتروني بنجاح. حسابك الآن
									<strong>مرتبط بالكامل بهذا البريد الإلكتروني مجدداً</strong>
									.
								</p>

								<p style="color: #475569; font-size: 15px; line-height: 1.7; margin-bottom: 28px">
									لقد تم فصل البريد الإلكتروني الآخر تماماً، وإلغاء صلاحية أي جلسات نشطة تم إنشاؤها خلال فترة محاولة
									النقل لحماية خصوصيتك وبياناتك.
								</p>

								<!-- Mandatory Password Reset Warning Box -->
								<table
									role="presentation"
									width="100%"
									cellspacing="0"
									cellpadding="0"
									border="0"
									style="margin-bottom: 28px"
								>
									<tr>
										<td
											style="
												background-color: #fff7ed;
												border-right: 4px solid #ea580c;
												padding: 18px;
												border-radius: 8px;
											"
										>
											<p style="color: #9a3412; font-size: 14px; margin: 0 0 8px 0; font-weight: 700">
												⚠️ خطوة أمنية هامة جداً: غيّـر كلمة مرورك الآن
											</p>
											<p style="color: #c2410c; font-size: 13px; margin: 0; line-height: 1.6">
												بما أنك اضطررت لإلغاء تغيير بريد غير مصرح به، فهذا دليل قاطع على أن
												<strong>كلمة مرورك الحالية أصبحت مكشوفة</strong>
												. يرجى تسجيل الدخول إلى حسابك فوراً وتغيير كلمة المرور إلى كلمة أخرى قوية وجديدة لمنع أي
												محاولة اختراق مستقبلاً.
											</p>
										</td>
									</tr>
								</table>

								<hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 25px 0" />

								<!-- Security Status Banner -->
								<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td
											style="
												background-color: #f0fdf4;
												border-right: 4px solid #22c55e;
												padding: 16px;
												border-radius: 8px;
											"
										>
											<p style="color: #15803d; font-size: 13px; margin: 0; font-weight: 600; line-height: 1.6">
												✅ تحديث الحماية: تمت إعادة تفعيل معايير الأمان السابقة وتأمين الحساب المرتبط بنجاح.
											</p>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<!-- Modern Footer -->
						<tr>
							<td
								style="
									background-color: #f8fafc;
									padding: 28px 35px;
									text-align: center;
									border-top: 1px solid #f1f5f9;
								"
							>
								<p style="color: #94a3b8; font-size: 12px; margin: 0 0 8px 0; line-height: 1.5">
									هذا تأكيد أمني تلقائي، يرجى عدم الرد على هذه الرسالة مباشرة.
								</p>
								<p style="color: #cbd5e1; font-size: 12px; margin: 0; font-weight: 500; direction: ltr">
									&copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
