<!-- 
  Email Reset Password Template - English Version (Modern UI)
  Expected Variables:
  - appName: string
  - link: string
  - name?: string (optional)
  - period?: number | string (optional, default: 10)
-->
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Your Password</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f0f4f8; margin: 0; padding: 0; direction: ltr; text-align: left; -webkit-font-smoothing: antialiased;">
  
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f0f4f8; padding: 40px 0;">
    <tr>
      <td align="center">
        
        <!-- Main Container Card -->
        <table role="presentation" width="100%" style="max-width: 580px; background-color: #ffffff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); overflow: hidden; border-collapse: collapse;">
          
          <!-- Modern Hero Header with Gradient & Security Icon -->
          <tr>
            <td style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%); padding: 45px 30px; text-align: center;">
              
              <!-- Lock Icon Wrapper -->
              <div style="display: inline-block; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); width: 64px; height: 64px; line-height: 64px; border-radius: 50%; margin-bottom: 16px; text-align: center;">
                <span style="font-size: 30px; line-height: 64px;">🔒</span>
              </div>
              
              <h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: 0.5px;">
                <%= appName %>
              </h1>
            </td>
          </tr>
          
          <!-- Body Content Area -->
          <tr>
            <td style="padding: 40px 35px;">
              <h2 style="color: #0f172a; margin-top: 0; margin-bottom: 20px; font-size: 22px; font-weight: 700;">
                Reset Your Password
              </h2>
              
              <p style="color: #334155; font-size: 15px; line-height: 1.7; margin-bottom: 16px;">
                Hello <strong style="color: #0f172a; text-transform: capitalize;"><%= typeof name !== 'undefined' && name ? name : 'Our dear client' %></strong>,
              </p>
              
              <p style="color: #475569; font-size: 15px; line-height: 1.7; margin-bottom: 32px;">
                We received a request to reset the password for your account on <strong><%= appName %></strong>. You can easily reset your password by clicking the button below:
              </p>
              
              <!-- Call to Action Button -->
              <div style="text-align: center; margin: 36px 0;">
                <a href="<%= link %>" target="_blank" style="display: inline-block; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #ffffff; font-size: 16px; font-weight: 700; text-decoration: none; padding: 16px 40px; border-radius: 50px; box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35); transition: all 0.3s ease;">
                  Reset Password
                </a>
              </div>

              <!-- Fallback Direct Link Block -->
              <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px; margin-bottom: 28px; text-align: center;">
                <p style="color: #64748b; font-size: 13px; line-height: 1.5; margin: 0 0 10px 0;">
                  If the button above doesn't work, copy and paste this link into your browser:
                </p>
                <a href="<%= link %>" style="color: #2563eb; font-size: 13px; word-break: break-all; font-weight: 500; text-decoration: underline;">
                  <%= link %>
                </a>
              </div>

              <!-- Link Expiration Details -->
              <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 28px;">
                This link is valid for only <strong style="color: #0f172a;"><%= typeof period !== 'undefined' && period ? period : 10 %> minutes</strong> for security reasons. If you did not request a password reset, you can safely ignore this email and your account remains secure.
              </p>
              
              <hr style="border: 0; border-top: 1px solid #f1f5f9; margin: 30px 0;">
              
              <!-- Security Warning Banner -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td style="background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 14px 18px; border-radius: 6px;">
                    <p style="color: #991b1b; font-size: 13px; margin: 0; font-weight: 600; line-height: 1.5;">
                      ⚠️ Security Notice: Never share this link with anyone under any circumstances to keep your account safe.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Modern Footer -->
          <tr>
            <td style="background-color: #f8fafc; padding: 28px 35px; text-align: center; border-top: 1px solid #f1f5f9;">
              <p style="color: #94a3b8; font-size: 12px; margin: 0 0 8px 0; line-height: 1.5;">
                This is an automated email, please do not reply to it directly.
              </p>
              <p style="color: #cbd5e1; font-size: 12px; margin: 0; font-weight: 500;">
                &copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.
              </p>
            </td>
          </tr>
          
        </table>
        
      </td>
    </tr>
  </table>
  
</body>
</html>